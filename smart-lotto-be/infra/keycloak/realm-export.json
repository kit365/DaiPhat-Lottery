{
  "realm": "smartlotto",
  "enabled": true,
  "roles": {
    "realm": [
      {
        "name": "ROLE_USER",
        "description": "Standard User Role"
      },
      {
        "name": "ROLE_ADMIN",
        "description": "Administrator Role"
      }
    ]
  },
  "clients": [
    {
      "clientId": "smartlotto-client",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "redirectUris": [
        "*"
      ],
      "webOrigins": [
        "+"
      ],
      "secret": "smartlotto-secret",
      "attributes": {
        "access.token.lifespan": "86400"
      }
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "email": "admin@smartlotto.com",
      "firstName": "Super",
      "lastName": "Admin",
      "credentials": [
        {
          "type": "password",
          "value": "admin",
          "temporary": false
        }
      ],
      "realmRoles": [
        "ROLE_ADMIN",
        "ROLE_USER"
      ]
    },
    {
      "username": "user",
      "enabled": true,
      "email": "user@smartlotto.com",
      "firstName": "John",
      "lastName": "Doe",
      "credentials": [
        {
          "type": "password",
          "value": "user",
          "temporary": false
        }
      ],
      "realmRoles": [
        "ROLE_USER"
      ]
    }
  ],
  "accessTokenLifespan": 86400,
  "ssoSessionIdleTimeout": 86400,
  "ssoSessionMaxLifespan": 86400
}
