# syntax=docker/dockerfile:1.7

FROM node:22-alpine AS frontend-build

WORKDIR /workspace/daiphat-fe

COPY daiphat-fe/package.json daiphat-fe/package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci

COPY daiphat-fe/ ./
# The staging branch currently has pre-existing TypeScript type-check failures.
# Vite still performs the production transpile/bundle needed for runtime validation.
RUN npm exec vite build

FROM maven:3.9.9-eclipse-temurin-21-alpine AS backend-build

WORKDIR /workspace/core-api

COPY daiphat-be/core-api/pom.xml ./

COPY daiphat-be/core-api/src ./src
COPY --from=frontend-build /workspace/daiphat-fe/dist ./src/main/resources/static

RUN --mount=type=cache,target=/root/.m2 \
    mvn -B clean package -Dmaven.test.skip=true -Dcheckstyle.skip

FROM eclipse-temurin:21-jre-alpine

WORKDIR /app

RUN addgroup -S daiphat \
    && adduser -S daiphat -G daiphat

COPY --from=backend-build --chown=daiphat:daiphat /workspace/core-api/target/*.jar /app/app.jar

USER daiphat

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=90s --retries=5 \
    CMD wget -qO- http://127.0.0.1:8080/actuator/health/readiness || exit 1

ENTRYPOINT ["java", "-jar", "/app/app.jar"]
