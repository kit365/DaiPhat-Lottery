# Copy thành .env rồi chỉnh giá trị cho máy bạn:
#   cp .env.example .env
#
# Android emulator dùng 10.0.2.2 thay cho localhost.
# Thiết bị thật: dùng IP LAN của máy chạy backend (vd: http://192.168.1.10:8080).

API_BASE_URL=http://10.0.2.2:8080
API_PREFIX=/api
API_VERSION=/v1

# Public Web OAuth client ID used as Google Sign-In serverClientId.
GOOGLE_WEB_CLIENT_ID=148374977555-0p9q96e74j5bknt1j1nagpoatf42op7c.apps.googleusercontent.com
# Public Android OAuth client ID registered with package name + SHA-1.
GOOGLE_ANDROID_CLIENT_ID=148374977555-ccibdup6vpvj3jkan655lhhr4378inu5.apps.googleusercontent.com

FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_APP_ID=
FIREBASE_ANDROID_API_KEY=
FIREBASE_ANDROID_APP_ID=
FIREBASE_IOS_API_KEY=
FIREBASE_IOS_APP_ID=
