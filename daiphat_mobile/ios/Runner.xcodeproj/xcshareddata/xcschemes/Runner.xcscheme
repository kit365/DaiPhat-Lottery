            </ActionContent>
         </ExecutionAction>
      </PreActions>
      <PostActions>
         <ExecutionAction
            ActionType = "Xcode.IDEStandardExecutionActionsCore.ExecutionActionType.ShellScriptAction">
            <ActionContent
               title = "Patch GeneratedPluginRegistrant.m (disable Firebase)"
               scriptText = "DISABLED_FILE=&quot;${SRCROOT}/Runner/GeneratedPluginRegistrant.m&quot;&#10;PATCHED_CONTENT='//&#10;//  Generated file. Do not edit.&#10;//&#10;&#10;// clang-format off&#10;&#10;@import Flutter;&#10;#import &quot;GeneratedPluginRegistrant.h&quot;&#10;&#10;#if __has_include(&lt;flutter_local_notifications/FlutterLocalNotificationsPlugin.h&gt;)&#10;#import &lt;flutter_local_notifications/FlutterLocalNotificationsPlugin.h&gt;&#10;#else&#10;@import flutter_local_notifications;&#10;#endif&#10;&#10;#if __has_include(&lt;image_picker_ios/FLTImagePickerPlugin.h&gt;)&#10;#import &lt;image_picker_ios/FLTImagePickerPlugin.h&gt;&#10;#else&#10;@import image_picker_ios;&#10;#endif&#10;&#10;#if __has_include(&lt;shared_preferences_foundation/SharedPreferencesPlugin.h&gt;)&#10;#import &lt;shared_preferences_foundation/SharedPreferencesPlugin.h&gt;&#10;#else&#10;@import shared_preferences_foundation;&#10;#endif&#10;&#10;#if __has_include(&lt;sqflite_darwin/SqflitePlugin.h&gt;)&#10;#import &lt;sqflite_darwin/SqflitePlugin.h&gt;&#10;#else&#10;@import sqflite_darwin;&#10;#endif&#10;&#10;#if __has_include(&lt;webview_flutter_wkwebview/WebViewFlutterPlugin.h&gt;)&#10;#import &lt;webview_flutter_wkwebview/WebViewFlutterPlugin.h&gt;&#10;#else&#10;@import webview_flutter_wkwebview;&#10;#endif&#10;&#10;@implementation GeneratedPluginRegistrant&#10;&#10;+ (void)registerWithRegistry:(NSObject&lt;FlutterPluginRegistry&gt;*)registry {&#10;  [FlutterLocalNotificationsPlugin registerWithRegistrar:[registry registrarForPlugin:@&quot;FlutterLocalNotificationsPlugin&quot;]];&#10;  [FLTImagePickerPlugin registerWithRegistrar:[registry registrarForPlugin:@&quot;FLTImagePickerPlugin&quot;]];&#10;  [SharedPreferencesPlugin registerWithRegistrar:[registry registrarForPlugin:@&quot;SharedPreferencesPlugin&quot;]];&#10;  [SqflitePlugin registerWithRegistrar:[registry registrarForPlugin:@&quot;SqflitePlugin&quot;]];&#10;  [WebViewFlutterPlugin registerWithRegistrar:[registry registrarForPlugin:@&quot;WebViewFlutterPlugin&quot;]];&#10;}&#10;&#10;@end&#10;'&#10;echo &quot;$PATCHED_CONTENT&quot; &gt; &quot;$DISABLED_FILE&quot;&#10;echo &quot;[PostAction] Patched GeneratedPluginRegistrant.m — Firebase plugins removed&quot;&#10;">
               <EnvironmentBuildable>
                  <BuildableReference
                     BuildableIdentifier = "primary"
                     BlueprintIdentifier = "97C146ED1CF9000F007C117D"
                     BuildableName = "Runner.app"
                     BlueprintName = "Runner"
                     ReferencedContainer = "container:Runner.xcodeproj">
                  </BuildableReference>
               </EnvironmentBuildable>
            </ActionContent>
         </ExecutionAction>
      </PostActions>
