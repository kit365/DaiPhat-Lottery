<mjml>
  <mj-head>
    <mj-title>Confirm your email address</mj-title>
    <mj-preview>Your confirmation code is DFY-X7U</mj-preview>
    <mj-attributes>
      <mj-all font-family="'Helvetica Neue', Helvetica, Arial, sans-serif"></mj-all>
      <mj-text font-size="16px" color="#94a3b8" line-height="24px"></mj-text>
      <mj-section background-color="#1e293b" padding="40px"></mj-section>
    </mj-attributes>
    <mj-style>
      .code-box {
        background-color: #0f172a !important;
        border: 1px dashed #34d399 !important;
        border-radius: 8px !important;
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#0f172a">
    
    <!-- Header -->
    <mj-section padding-bottom="0px">
      <mj-column>
        <mj-image src="https://imgs.emailmd.dev/logoipsum-388.png" alt="Logo" width="180px" align="center"></mj-image>
        <mj-divider border-color="#334155" border-width="1px" padding-top="20px"></mj-divider>
      </mj-column>
    </mj-section>

    <!-- Main Content -->
    <mj-section>
      <mj-column>
        <mj-text align="center" font-size="24px" font-weight="bold" color="#f1f5f9">
          Confirm your email address
        </mj-text>
        <mj-text align="center">
          Your confirmation code is below - enter it in your open browser window and we'll help you get signed in.
        </mj-text>
        
        <!-- Callout Code -->
        <mj-section css-class="code-box" padding="30px">
          <mj-column>
            <mj-text align="center" font-size="42px" font-weight="bold" color="#34d399" letter-spacing="5px" padding="0">
              DFY-X7U
            </mj-text>
          </mj-column>
        </mj-section>
        
        <mj-text align="center" font-size="14px" padding-top="20px">
          If you didn't request this email, there's nothing to worry about, you có thể an tâm bỏ qua nó.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Footer -->
    <mj-section background-color="transparent" padding-top="20px">
      <mj-column>
        <mj-divider border-color="#334155" border-width="1px"></mj-divider>
        <mj-image src="https://imgs.emailmd.dev/logoipsum-389.png" width="48px" align="center" padding-top="20px"></mj-image>
        <mj-text align="center" font-size="12px" color="#64748b">
          Acme Inc. | 123 Main St | <a href="https://example.com/unsub" style="color: #38bdf8; text-decoration: none;">Unsubscribe</a>
        </mj-text>
        <mj-social font-size="15px" icon-size="24px" mode="horizontal" align="center">
          <mj-social-element src="https://imgs.emailmd.dev/linkedin_negative.png" href="#"></mj-social-element>
          <mj-social-element src="https://imgs.emailmd.dev/github_negative.png" href="#"></mj-social-element>
          <mj-social-element src="https://imgs.emailmd.dev/discord_negative.png" href="#"></mj-social-element>
        </mj-social>
      </mj-column>
    </mj-section>

  </mj-body>
</mjml>
